@model PureTechnologyTask.Models.manager

@{
    ViewData["Title"] = "Add Manager";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Add Manager</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: linear-gradient(135deg, #e0f2fe, #eef2ff);
            font-family: Arial, sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 25px;
        }

        .manager-card {
            width: 100%;
            max-width: 600px;
            background: white;
            padding: 35px;
            border-radius: 18px;
            box-shadow: 0 10px 35px rgba(0, 0, 0, 0.12);
        }

            .manager-card h2 {
                color: #1e3a8a;
                font-weight: 700;
                text-align: center;
                margin-bottom: 8px;
            }

        .subtitle {
            text-align: center;
            color: #64748b;
            margin-bottom: 28px;
        }

        .form-label {
            font-weight: 600;
            color: #334155;
        }

        .form-control {
            padding: 11px;
            border-radius: 9px;
        }

        .btn-save {
            background: #2563eb;
            color: white;
            padding: 12px;
            border-radius: 9px;
            font-weight: 600;
        }

            .btn-save:hover {
                background: #1d4ed8;
                color: white;
            }
    </style>
</head>
<body>

    <div class="manager-card">
        <h2>Add Manager</h2>
        <p class="subtitle">Enter the manager details below</p>

        <form asp-controller="Admin" asp-action="Add_Manager" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="name" class="form-label">Manager Name</label>
                <input asp-for="name" class="form-control"
                       placeholder="Enter manager name" required />
            </div>

            <div class="mb-3">
                <label asp-for="email" class="form-label">Email Address</label>
                <input asp-for="email" type="email" class="form-control"
                       placeholder="Enter email address" required />
            </div>

            <div class="mb-3">
                <label asp-for="phone" class="form-label">Phone Number</label>
                <input asp-for="phone" class="form-control"
                       placeholder="Enter phone number" required />
            </div>

            <div class="mb-3">
                <label asp-for="password" class="form-label">Password</label>
                <input asp-for="password" type="password" class="form-control"
                       placeholder="Enter password" required />
            </div>

            <div class="mb-4">
                <label asp-for="Branch" class="form-label">Branch</label>
                <input asp-for="Branch" class="form-control"
                       placeholder="Enter branch name" required />
            </div>

            <button type="submit" class="btn btn-save w-100">
                Save Manager
            </button>

            <a asp-controller="Admin" asp-action="Manage_Managers"
               class="btn btn-outline-secondary w-100 mt-2">
                Back to Managers
            </a>
        </form>
    </div>

</body>
</html>
