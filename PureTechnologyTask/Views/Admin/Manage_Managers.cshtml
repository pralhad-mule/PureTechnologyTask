@*
    Manage Managers View
*@
@model IEnumerable<PureTechnologyTask.Models.manager>

@{
    ViewData["Title"] = "Manage Managers";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Manage Managers - Lemon Tree Hotel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            padding: 30px;
            min-height: 100vh;
            background: #f1f5f9;
            font-family: Arial, sans-serif;
        }

        .manager-container {
            max-width: 1200px;
            margin: auto;
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        }

        .page-title {
            color: #123047;
            font-weight: bold;
        }

        .table thead {
            background: #123047;
            color: white;
        }

            .table thead th {
                background: #123047;
                color: white;
                white-space: nowrap;
            }

        .table td {
            vertical-align: middle;
        }

        .btn {
            border-radius: 7px;
        }

        @@media (max-width: 768px) {
            body {
                padding: 12px;
            }

            .manager-container {
                padding: 15px;
            }
        }
    </style>
</head>
<body>

    <div class="manager-container">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h2 class="page-title">Manage Managers</h2>
                <p class="text-secondary mb-0">
                    Lemon Tree Hotel Administration
                </p>
            </div>

            <a asp-controller="Admin"
               asp-action="Add_Manager"
               class="btn btn-primary">
                + Add Manager
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Manager Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Branch</th>
                        <th style="min-width: 160px;">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.id</td>
                                <td>@item.name</td>
                                <td>@item.email</td>
                                <td>@item.phone</td>
                                <td>@item.Branch</td>
                                <td>
                                    <a asp-controller="Admin"
                                       asp-action="editmanager"
                                       asp-route-id="@item.id"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>

                                    <a asp-controller="Admin"
                                       asp-action="deletemanager"
                                       asp-route-id="@item.id"
                                       class="btn btn-sm btn-danger">
                                        Delete
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-secondary py-4">
                                No managers found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <a asp-controller="Admin"
           asp-action="admindashbord"
           class="btn btn-outline-secondary mt-3">
            Back to Dashboard
        </a>

    </div>

</body>
</html>
