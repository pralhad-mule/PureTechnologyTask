@*
    Manage Users View
*@
@model IEnumerable<PureTechnologyTask.Models.userRegister>

@{
    ViewData["Title"] = "Manage Users";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Manage Users - Lemon Tree Hotel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            padding: 30px;
            min-height: 100vh;
            background: #f1f5f9;
            font-family: Arial, sans-serif;
        }

        .user-container {
            max-width: 1250px;
            margin: auto;
            padding: 30px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
        }

        .page-title {
            color: #123047;
            font-weight: bold;
        }

        .table thead th {
            background: #123047;
            color: white;
            white-space: nowrap;
        }

        .table td {
            vertical-align: middle;
        }

        @@media (max-width: 768px) {
            body {
                padding: 12px;
            }

            .user-container {
                padding: 15px;
            }
        }
    </style>
</head>
<body>

    <div class="user-container">

        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h2 class="page-title">Manage Users</h2>
                <p class="text-secondary mb-0">
                    Lemon Tree Hotel Administration
                </p>
            </div>

            <a asp-controller="Admin"
               asp-action="admindashbord"
               class="btn btn-outline-primary">
                Back to Dashboard
            </a>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Mobile Number</th>
                        <th>Gender</th>
                        <th>Date of Birth</th>
                        <th>Address</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.id</td>
                                <td>@item.name</td>
                                <td>@item.email</td>
                                <td>@item.mobile_no</td>
                                <td>@item.gender</td>
                                <td>@item.Date_of_birth</td>
                                <td>@item.address</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-secondary py-4">
                                No users found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>

</body>
</html>
