    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@*
    Admin Dashboard View
*@
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Dashboard - Lemon Tree Hotel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f1f5f9;
        }

        .sidebar {
            width: 250px;
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            background: #123047;
            color: white;
            padding: 25px 15px;
        }

            .sidebar h4 {
                text-align: center;
                color: #fbbf24;
                margin-bottom: 35px;
                font-weight: bold;
            }

            .sidebar a {
                display: block;
                color: #e2e8f0;
                text-decoration: none;
                padding: 13px 15px;
                border-radius: 8px;
                margin-bottom: 8px;
            }

                .sidebar a:hover,
                .sidebar a.active {
                    background: #2563eb;
                    color: white;
                }

        .main-content {
            margin-left: 250px;
            padding: 30px;
        }

        .topbar {
            background: white;
            padding: 20px 25px;
            border-radius: 12px;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
            margin-bottom: 25px;
        }

        .dashboard-card {
            background: white;
            padding: 25px;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
            height: 100%;
        }

            .dashboard-card h6 {
                color: #64748b;
                margin-bottom: 15px;
            }

            .dashboard-card h2 {
                color: #123047;
                font-weight: bold;
            }

        .card-icon {
            font-size: 30px;
            margin-bottom: 12px;
        }

        .section-title {
            color: #123047;
            font-weight: bold;
            margin-bottom: 20px;
        }

        .quick-link {
            display: block;
            text-decoration: none;
            background: white;
            padding: 20px;
            border-radius: 12px;
            color: #123047;
            font-weight: bold;
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
            height: 100%;
        }

            .quick-link:hover {
                background: #e0f2fe;
                color: #1d4ed8;
            }

        @@media (max-width: 768px) {
            .sidebar {
                position: relative;
                width: 100%;
                min-height: auto;
            }

            .main-content {
                margin-left: 0;
                padding: 18px;
            }
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <h4>🍋 Lemon Tree</h4>

        <a asp-controller="Admin" asp-action="admindashbord" class="active">
            🏠 Dashboard
        </a>

        <a asp-controller="Admin" asp-action="Manage_Managers">
            👨‍💼 Manage Managers
        </a>

        <a asp-controller="Admin" asp-action="Add_Manager">
            ➕ Add Manager
        </a>

        <a asp-controller="Admin" asp-action="Manage_user">
            👥 Manage Users
        </a>

        <a asp-controller="Home" asp-action="Index">
            🌐 Visit Website
        </a>

        <a asp-controller="Admin" asp-action="Adminlogin">
            🚪 Logout
        </a>
    </div>

    <div class="main-content">

        <div class="topbar d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <h3 class="mb-1">Admin Dashboard</h3>
                <p class="text-secondary mb-0">
                    Welcome to Lemon Tree Hotel Administration
                </p>
            </div>

            <span class="badge text-bg-primary p-2">Administrator</span>
        </div>

        <div class="row g-4 mb-4">

            <div class="col-md-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="card-icon">👨‍💼</div>
                    <h6>Total Managers</h6>
                    <h2>Manage</h2>
                    <a asp-controller="Admin" asp-action="Manage_Managers"
                       class="btn btn-outline-primary mt-3">
                        View Managers
                    </a>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="card-icon">👥</div>
                    <h6>Registered Users</h6>
                    <h2>Manage</h2>
                    <a asp-controller="Admin" asp-action="Manage_user"
                       class="btn btn-outline-success mt-3">
                        View Users
                    </a>
                </div>
            </div>

            <div class="col-md-6 col-xl-4">
                <div class="dashboard-card">
                    <div class="card-icon">➕</div>
                    <h6>Manager Registration</h6>
                    <h2>Add New</h2>
                    <a asp-controller="Admin" asp-action="Add_Manager"
                       class="btn btn-outline-warning mt-3">
                        Add Manager
                    </a>
                </div>
            </div>

        </div>

        <h4 class="section-title">Quick Actions</h4>

        <div class="row g-4">

            <div class="col-md-6 col-lg-4">
                <a asp-controller="Admin" asp-action="Manage_Managers"
                   class="quick-link">
                    👨‍💼 Manage Managers
                    <p class="text-secondary fw-normal mt-2 mb-0">
                        View and manage hotel managers.
                    </p>
                </a>
            </div>

            <div class="col-md-6 col-lg-4">
                <a asp-controller="Admin" asp-action="Add_Manager"
                   class="quick-link">
                    ➕ Add Manager
                    <p class="text-secondary fw-normal mt-2 mb-0">
                        Register a new manager.
                    </p>
                </a>
            </div>

            <div class="col-md-6 col-lg-4">
                <a asp-controller="Admin" asp-action="Manage_user"
                   class="quick-link">
                    👥 Manage Users
                    <p class="text-secondary fw-normal mt-2 mb-0">
                        Access registered user management.
                    </p>
                </a>
            </div>

        </div>

    </div>

</body>
</html>
