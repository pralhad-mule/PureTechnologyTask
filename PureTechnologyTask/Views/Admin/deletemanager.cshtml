@*
    Delete Manager View
*@
@{
    ViewData["Title"] = "Delete Manager";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Delete Manager - Lemon Tree Hotel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: linear-gradient(135deg, #fff1f2, #fee2e2);
            font-family: Arial, sans-serif;
        }

        .delete-card {
            width: 100%;
            max-width: 480px;
            background: white;
            padding: 35px;
            border-radius: 16px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);
            text-align: center;
        }

        .delete-icon {
            font-size: 48px;
            margin-bottom: 15px;
        }

        h2 {
            color: #b91c1c;
            font-weight: bold;
            margin-bottom: 15px;
        }

        p {
            color: #64748b;
            margin-bottom: 25px;
        }

        .btn-delete {
            background: #dc2626;
            color: white;
        }

            .btn-delete:hover {
                background: #b91c1c;
                color: white;
            }
    </style>
</head>
<body>

    <div class="delete-card">
        <div class="delete-icon">⚠️</div>

        <h2>Delete Manager</h2>

        <p>
            Are you sure you want to delete this manager?
            This action cannot be undone.
        </p>

        <form asp-controller="Admin" asp-action="deletemanager" method="post">
            @Html.AntiForgeryToken()

            <input type="hidden" name="id" value="@ViewBag.id" />

            <button type="submit" class="btn btn-delete w-100 mb-2">
                Confirm Delete
            </button>

            <a asp-controller="Admin"
               asp-action="Manage_Managers"
               class="btn btn-outline-secondary w-100">
                Cancel
            </a>
        </form>
    </div>

</body>
</html>
