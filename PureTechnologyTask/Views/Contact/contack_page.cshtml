@*
    Contact Page View
*@
@{
    ViewData["Title"] = "Contact Us";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Contact Us - Lemon Tree Hotel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #eff6ff, #f8fafc);
            min-height: 100vh;
        }

        .navbar {
            background: #123047;
            padding: 15px 30px;
        }

        .navbar-brand {
            color: #fbbf24;
            font-weight: bold;
            font-size: 23px;
        }

            .navbar-brand:hover {
                color: #fbbf24;
            }

        .contact-section {
            max-width: 1100px;
            margin: 45px auto;
            padding: 20px;
        }

        .contact-heading {
            text-align: center;
            margin-bottom: 35px;
        }

            .contact-heading h1 {
                color: #123047;
                font-weight: bold;
            }

        .contact-card {
            background: white;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 6px 25px rgba(0, 0, 0, 0.08);
            height: 100%;
        }

            .contact-card h4 {
                color: #123047;
                font-weight: bold;
                margin-bottom: 20px;
            }

        .contact-info {
            margin-bottom: 22px;
            color: #475569;
        }

            .contact-info strong {
                display: block;
                color: #123047;
                margin-bottom: 5px;
            }

        .form-label {
            font-weight: 600;
            color: #334155;
        }

        .form-control {
            padding: 12px;
            border-radius: 8px;
        }

        .btn-contact {
            background: #2563eb;
            color: white;
            padding: 12px;
            border-radius: 8px;
            font-weight: bold;
        }

            .btn-contact:hover {
                background: #1d4ed8;
                color: white;
            }

        footer {
            background: #123047;
            color: white;
            text-align: center;
            padding: 18px;
            margin-top: 40px;
        }
    </style>
</head>
<body>

    <nav class="navbar">
        <div class="container-fluid">
            <a asp-controller="Home" asp-action="Index"
               class="navbar-brand text-decoration-none">
                🍋 Lemon Tree Hotel
            </a>

            <a asp-controller="Home" asp-action="Index"
               class="btn btn-outline-light">
                Back to Home
            </a>
        </div>
    </nav>

    <section class="contact-section">

        <div class="contact-heading">
            <h1>Contact Us</h1>
            <p class="text-secondary">
                We would love to hear from you. Contact us for any questions or assistance.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-5">
                <div class="contact-card">
                    <h4>Get in Touch</h4>

                    <div class="contact-info">
                        <strong>📍 Address</strong>
                        Lemon Tree Hotel
                        <p class="mb-0">Please contact the hotel for its full address.</p>
                    </div>

                    <div class="contact-info">
                        <strong>📞 Phone</strong>
                        <p class="mb-0">Contact the hotel reception.</p>
                    </div>

                    <div class="contact-info">
                        <strong>✉️ Email</strong>
                        <p class="mb-0">Contact the hotel for its email address.</p>
                    </div>

                    <div class="contact-info">
                        <strong>🕒 Reception</strong>
                        <p class="mb-0">Contact reception for availability and assistance.</p>
                    </div>
                </div>
            </div>

            <div class="col-md-7">
                <div class="contact-card">
                    <h4>Send Us a Message</h4>

                    <form method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label for="name" class="form-label">Full Name</label>
                            <input type="text" id="name" name="name"
                                   class="form-control"
                                   placeholder="Enter your full name" required />
                        </div>

                        <div class="mb-3">
                            <label for="email" class="form-label">Email Address</label>
                            <input type="email" id="email" name="email"
                                   class="form-control"
                                   placeholder="Enter your email" required />
                        </div>

                        <div class="mb-3">
                            <label for="subject" class="form-label">Subject</label>
                            <input type="text" id="subject" name="subject"
                                   class="form-control"
                                   placeholder="Enter message subject" required />
                        </div>

                        <div class="mb-3">
                            <label for="message" class="form-label">Message</label>
                            <textarea id="message" name="message"
                                      class="form-control" rows="5"
                                      placeholder="Write your message here..."
                                      required></textarea>
                        </div>

                        <button type="submit" class="btn btn-contact w-100">
                            Send Message
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </section>

    <footer>
        <p class="mb-0">
            &copy; @DateTime.Now.Year Lemon Tree Hotel. All rights reserved.
        </p>
    </footer>

</body>
</html>
