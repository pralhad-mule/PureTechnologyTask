@*
    Manager Registration View
*@
@model PureTechnologyTask.Models.manager

@{
    ViewData["Title"] = "Manager Registration";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Manager Registration - Lemon Tree Hotel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #123047, #2563eb);
        }

        .manager-card {
            width: 100%;
            max-width: 600px;
            background: white;
            padding: 35px;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        h2 {
            text-align: center;
            color: #123047;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .subtitle {
            text-align: center;
            color: #64748b;
            margin-bottom: 28px;
        }

        .form-label {
            font-weight: 600;
            color: #334155;
        }

        .form-control {
            padding: 11px;
            border-radius: 8px;
        }

        .btn-save {
            background: #2563eb;
            color: white;
            padding: 12px;
            border: none;
            border-radius: 8px;
            font-weight: bold;
        }

            .btn-save:hover {
                background: #1d4ed8;
                color: white;
            }
    </style>
</head>
<body>

    <div class="manager-card">
        <h2>🍋 Manager Registration</h2>
        <p class="subtitle">Lemon Tree Hotel Administration</p>

        @if (ViewData["Status"] != null)
        {
            <div class="alert alert-info">
                @ViewData["Status"]
            </div>
        }

        <form asp-controller="Manager" asp-action="Index" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="name" class="form-label">Manager Name</label>
                <input asp-for="name" class="form-control"
                       placeholder="Enter manager name" required />
            </div>

            <div class="mb-3">
                <label asp-for="email" class="form-label">Email Address</label>
                <input asp-for="email" type="email" class="form-control"
                       placeholder="Enter email address" required />
            </div>

            <div class="mb-3">
                <label asp-for="phone" class="form-label">Phone Number</label>
                <input asp-for="phone" class="form-control"
                       placeholder="Enter phone number" required />
            </div>

            <div class="mb-3">
                <label asp-for="password" class="form-label">Password</label>
                <input asp-for="password" type="password" class="form-control"
                       placeholder="Enter password" required />
            </div>

            <div class="mb-4">
                <label asp-for="Branch" class="form-label">Branch</label>
                <input asp-for="Branch" class="form-control"
                       placeholder="Enter branch name" required />
            </div>

            <button type="submit" class="btn btn-save w-100">
                Register Manager
            </button>

            <a asp-controller="Home" asp-action="Index"
               class="btn btn-outline-secondary w-100 mt-2">
                Back to Home
            </a>
        </form>
    </div>

</body>
</html>
