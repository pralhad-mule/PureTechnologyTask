@{
    ViewData["Title"] = "Manage Rooms";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Manage Rooms - Lemon Tree Hotel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            background: #f4f7fb;
            font-family: Arial, sans-serif;
        }

        .sidebar {
            min-height: 100vh;
            background: #123047;
            padding: 25px 15px;
            color: white;
        }

            .sidebar h4 {
                text-align: center;
                margin-bottom: 30px;
                font-weight: bold;
            }

            .sidebar a {
                display: block;
                padding: 12px 15px;
                margin-bottom: 8px;
                color: white;
                text-decoration: none;
                border-radius: 7px;
            }

                .sidebar a:hover,
                .sidebar a.active {
                    background: #2563eb;
                }

        .main-content {
            padding: 30px;
        }

        .room-card {
            background: white;
            border-radius: 12px;
            padding: 25px;
            height: 100%;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.07);
            transition: transform 0.2s;
        }

            .room-card:hover {
                transform: translateY(-5px);
            }

        .room-icon {
            font-size: 38px;
            margin-bottom: 12px;
        }

        .room-card h5 {
            color: #123047;
            font-weight: bold;
        }

        .btn-room {
            background: #2563eb;
            color: white;
            border-radius: 7px;
            padding: 9px 18px;
            text-decoration: none;
            display: inline-block;
        }

            .btn-room:hover {
                background: #1d4ed8;
                color: white;
            }

        @@media (max-width: 767px) {
            .sidebar {
                min-height: auto;
            }

            .main-content {
                padding: 18px;
            }
        }
    </style>
</head>
<body>

    <div class="container-fluid">
        <div class="row">

            <div class="col-md-3 col-lg-2 sidebar">
                <h4>🍋 Lemon Tree</h4>

                <a asp-controller="Manager" asp-action="managerdashbord">
                    Dashboard
                </a>

                <a asp-controller="Manager" asp-action="User">
                    Manage Users
                </a>

                <a asp-controller="Manager" asp-action="Room" class="active">
                    Manage Rooms
                </a>

                <a asp-controller="Rooms" asp-action="book_room">
                    Book a Room
                </a>

                <a asp-controller="Home" asp-action="Index">
                    Home
                </a>

                <a asp-controller="Manager" asp-action="managerlogin">
                    Logout
                </a>
            </div>

            <div class="col-md-9 col-lg-10 main-content">

                <h2 class="fw-bold mb-2">Manage Rooms</h2>
                <p class="text-secondary mb-4">
                    View available room categories and manage hotel bookings.
                </p>

                <div class="row g-4">

                    <div class="col-sm-6 col-xl-4">
                        <div class="room-card">
                            <div class="room-icon">🛏️</div>
                            <h5>Standard Room</h5>
                            <p class="text-secondary">
                                A comfortable room for everyday stays.
                            </p>
                            <a asp-controller="Rooms"
                               asp-action="view_details_standard"
                               class="btn-room">View Details</a>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-4">
                        <div class="room-card">
                            <div class="room-icon">🏨</div>
                            <h5>Deluxe Room</h5>
                            <p class="text-secondary">
                                Extra comfort for a relaxing stay.
                            </p>
                            <a asp-controller="Rooms"
                               asp-action="view_details_delux"
                               class="btn-room">View Details</a>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-4">
                        <div class="room-card">
                            <div class="room-icon">✨</div>
                            <h5>Super Deluxe Room</h5>
                            <p class="text-secondary">
                                A spacious room with premium comfort.
                            </p>
                            <a asp-controller="Rooms"
                               asp-action="view_details_superdelux"
                               class="btn-room">View Details</a>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-4">
                        <div class="room-card">
                            <div class="room-icon">👨‍👩‍👧‍👦</div>
                            <h5>Family Room</h5>
                            <p class="text-secondary">
                                Space and comfort for the whole family.
                            </p>
                            <a asp-controller="Rooms"
                               asp-action="view_details_family"
                               class="btn-room">View Details</a>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-4">
                        <div class="room-card">
                            <div class="room-icon">👑</div>
                            <h5>Presidential Room</h5>
                            <p class="text-secondary">
                                An elegant room for a premium experience.
                            </p>
                            <a asp-controller="Rooms"
                               asp-action="view_details_president"
                               class="btn-room">View Details</a>
                        </div>
                    </div>

                    <div class="col-sm-6 col-xl-4">
                        <div class="room-card">
                            <div class="room-icon">💼</div>
                            <h5>Business Room</h5>
                            <p class="text-secondary">
                                A convenient option for business travellers.
                            </p>
                            <a asp-controller="Rooms"
                               asp-action="view_details_business"
                               class="btn-room">View Details</a>
                        </div>
                    </div>

                </div>

                <div class="mt-4">
                    <a asp-controller="Rooms"
                       asp-action="book_room"
                       class="btn btn-success">
                        + Book a Room
                    </a>
                </div>

            </div>
        </div>
    </div>

</body>
</html>
