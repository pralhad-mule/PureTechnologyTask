@{
    ViewData["Title"] = "Manage Users";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Manage Users - Lemon Tree Hotel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            background: #f4f7fb;
            font-family: Arial, sans-serif;
        }

        .sidebar {
            min-height: 100vh;
            background: #123047;
            padding: 25px 15px;
            color: white;
        }

            .sidebar h4 {
                text-align: center;
                margin-bottom: 30px;
                font-weight: bold;
            }

            .sidebar a {
                display: block;
                padding: 12px 15px;
                margin-bottom: 8px;
                color: white;
                text-decoration: none;
                border-radius: 7px;
            }

                .sidebar a:hover,
                .sidebar a.active {
                    background: #2563eb;
                }

        .main-content {
            padding: 30px;
        }

        .user-card {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.07);
        }

        .table th {
            background: #123047;
            color: white;
            white-space: nowrap;
        }

        .table td {
            vertical-align: middle;
        }

        @@media (max-width: 767px) {
            .sidebar {
                min-height: auto;
            }

            .main-content {
                padding: 18px;
            }
        }
    </style>
</head>
<body>

    <div class="container-fluid">
        <div class="row">

            <div class="col-md-3 col-lg-2 sidebar">
                <h4>🍋 Lemon Tree</h4>

                <a asp-controller="Manager" asp-action="managerdashbord">
                    Dashboard
                </a>

                <a asp-controller="Manager" asp-action="User" class="active">
                    Manage Users
                </a>

                <a asp-controller="Manager" asp-action="Room">
                    Manage Rooms
                </a>

                <a asp-controller="Rooms" asp-action="book_room">
                    Book a Room
                </a>

                <a asp-controller="Home" asp-action="Index">
                    Home
                </a>

                <a asp-controller="Manager" asp-action="managerlogin">
                    Logout
                </a>
            </div>

            <div class="col-md-9 col-lg-10 main-content">

                <h2 class="fw-bold mb-2">Manage Users</h2>
                <p class="text-secondary mb-4">
                    View registered hotel customers.
                </p>

                <div class="user-card">
                    <h5 class="mb-3">Registered Users</h5>

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover">
                            <thead>
                                <tr>
                                    <th>User ID</th>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Mobile Number</th>
                                    <th>Gender</th>
                                    <th>Date of Birth</th>
                                    <th>Address</th>
                                </tr>
                            </thead>

                            <tbody>
                                <tr>
                                    <td colspan="7" class="text-center text-secondary">
                                        User records will appear here when connected
                                        to the database.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <a asp-controller="Manager"
                       asp-action="managerdashbord"
                       class="btn btn-secondary mt-2">
                        Back to Dashboard
                    </a>
                </div>

            </div>
        </div>
    </div>

</body>
</html>
