@*
    Manager Dashboard View
*@
@model IEnumerable<PureTechnologyTask.Models.Booking>

@{
    ViewData["Title"] = "Manager Dashboard";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Manager Dashboard - Lemon Tree Hotel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f1f5f9;
        }

        .sidebar {
            width: 250px;
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            padding: 25px 15px;
            background: #123047;
            color: white;
        }

            .sidebar h4 {
                text-align: center;
                color: #fbbf24;
                font-weight: bold;
                margin-bottom: 35px;
            }

            .sidebar a {
                display: block;
                padding: 13px 15px;
                margin-bottom: 8px;
                color: #e2e8f0;
                text-decoration: none;
                border-radius: 8px;
            }

                .sidebar a:hover,
                .sidebar a.active {
                    background: #2563eb;
                    color: white;
                }

        .main-content {
            margin-left: 250px;
            padding: 30px;
        }

        .topbar,
        .dashboard-card,
        .table-card {
            background: white;
            border-radius: 14px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
        }

        .topbar {
            padding: 22px 25px;
            margin-bottom: 25px;
        }

        .dashboard-card {
            padding: 25px;
            height: 100%;
        }

            .dashboard-card h6 {
                color: #64748b;
            }

            .dashboard-card h2 {
                color: #123047;
                font-weight: bold;
                margin-top: 12px;
            }

        .card-icon {
            font-size: 32px;
        }

        .table-card {
            padding: 25px;
            margin-top: 25px;
        }

        .table thead th {
            background: #123047;
            color: white;
            white-space: nowrap;
        }

        .table td {
            vertical-align: middle;
        }

        @@media (max-width: 768px) {
            .sidebar {
                position: relative;
                width: 100%;
                min-height: auto;
            }

            .main-content {
                margin-left: 0;
                padding: 15px;
            }
        }
    </style>
</head>
<body>

    <div class="sidebar">
        <h4>🍋 Lemon Tree</h4>

        <a asp-controller="Manager" asp-action="managerdashbord"
           class="active">
            🏠 Dashboard
        </a>

        <a asp-controller="Manager" asp-action="User">
            👥 Users
        </a>

        <a asp-controller="Manager" asp-action="Room">
            🛏️ Room Management
        </a>

        <a asp-controller="Rooms" asp-action="book_room">
            ➕ New Booking
        </a>

        <a asp-controller="Home" asp-action="Index">
            🌐 Visit Website
        </a>

        <a asp-controller="Manager" asp-action="managerlogin">
            🚪 Logout
        </a>
    </div>

    <div class="main-content">

        <div class="topbar d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h3 class="mb-1">Manager Dashboard</h3>
                <p class="text-secondary mb-0">
                    Lemon Tree Hotel Management Portal
                </p>
            </div>

            <span class="badge text-bg-primary p-2">Manager</span>
        </div>

        <div class="row g-4">

            <div class="col-md-6">
                <div class="dashboard-card">
                    <div class="card-icon">👥</div>
                    <h6>Total Registered Users</h6>
                    <h2>@ViewBag.TotalUsers</h2>
                </div>
            </div>

            <div class="col-md-6">
                <div class="dashboard-card">
                    <div class="card-icon">🛏️</div>
                    <h6>Total Room Bookings</h6>
                    <h2>@ViewBag.TotalBookings</h2>
                </div>
            </div>

        </div>

        <div class="table-card">
            <h4 class="mb-4">Recent Room Bookings</h4>

            <div class="table-responsive">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Booking ID</th>
                            <th>Customer Name</th>
                            <th>Room Type</th>
                            <th>Check-in Date</th>
                            <th>Check-out Date</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>@item.custimername</td>
                                    <td>@item.roomtype</td>
                                    <td>@item.CheckInDate</td>
                                    <td>@item.CheckOutDate</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-secondary py-4">
                                    No recent bookings found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>

</body>
</html>
