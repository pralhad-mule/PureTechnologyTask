@{
    ViewData["Title"] = "Restaurant Menu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Restaurant Menu - Lemon Tree Hotel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f7fa;
            color: #263238;
        }

        .navbar-custom {
            background: #123047;
            padding: 15px 25px;
        }

        .navbar-brand {
            color: white !important;
            font-size: 23px;
            font-weight: bold;
        }

        .navbar-custom .nav-link {
            color: white;
            margin-left: 12px;
        }

            .navbar-custom .nav-link:hover {
                color: #ffc107;
            }

        .hero {
            padding: 65px 20px;
            text-align: center;
            color: white;
            background: linear-gradient(135deg, #123047, #2563eb);
        }

            .hero h1 {
                font-size: 42px;
                font-weight: bold;
            }

            .hero p {
                font-size: 17px;
                margin-top: 12px;
            }

        .section-title {
            text-align: center;
            margin: 40px 0 25px;
            color: #123047;
            font-weight: bold;
        }

        .menu-card {
            background: white;
            border-radius: 14px;
            overflow: hidden;
            height: 100%;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.08);
            transition: transform 0.2s;
        }

            .menu-card:hover {
                transform: translateY(-5px);
            }

        .food-image {
            height: 190px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #e8eef5;
            font-size: 65px;
        }

        .menu-content {
            padding: 22px;
        }

            .menu-content h5 {
                font-weight: bold;
                color: #123047;
            }

        .food-price {
            color: #198754;
            font-size: 20px;
            font-weight: bold;
        }

        .food-category {
            color: #64748b;
            font-size: 14px;
        }

        .btn-order {
            background: #2563eb;
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 7px;
            text-decoration: none;
            display: inline-block;
        }

            .btn-order:hover {
                background: #1d4ed8;
                color: white;
            }

        .order-section {
            margin: 45px 0;
            padding: 35px 20px;
            text-align: center;
            background: white;
            border-radius: 12px;
        }

        footer {
            background: #123047;
            color: white;
            text-align: center;
            padding: 20px;
            margin-top: 40px;
        }

        @@media (max-width: 576px) {
            .hero h1 {
                font-size: 30px;
            }

            .navbar-custom {
                padding: 12px;
            }
        }
    </style>
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark navbar-custom">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                🍋 Lemon Tree Hotel
            </a>

            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#hotelNavbar"
                    aria-controls="hotelNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="hotelNavbar">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Rooms" asp-action="Room">
                            Rooms
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Resturent" asp-action="resturentmenu">
                            Restaurant Menu
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Contact" asp-action="contack_page">
                            Contact
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <section class="hero">
        <div class="container">
            <h1>Our Restaurant Menu</h1>
            <p>
                Discover delicious food and refreshing beverages
                at Lemon Tree Hotel.
            </p>

            <a asp-controller="Resturent"
               asp-action="ordernow"
               class="btn btn-warning mt-3 px-4 py-2">
                Order Your Food
            </a>
        </div>
    </section>

    <div class="container">

        <h2 class="section-title">🍽️ Explore Our Menu</h2>

        <div class="row g-4">

            <div class="col-sm-6 col-lg-4">
                <div class="menu-card">
                    <div class="food-image">🥪</div>
                    <div class="menu-content">
                        <span class="food-category">Snacks</span>
                        <h5 class="mt-2">Vegetable Sandwich</h5>
                        <p class="text-secondary">
                            Fresh vegetables with tasty sandwich filling.
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="food-price">₹120</span>
                            <a asp-controller="Resturent"
                               asp-action="ordernow"
                               class="btn-order">Order Now</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="menu-card">
                    <div class="food-image">🍛</div>
                    <div class="menu-content">
                        <span class="food-category">Lunch</span>
                        <h5 class="mt-2">Paneer Biryani</h5>
                        <p class="text-secondary">
                            Aromatic rice prepared with delicious paneer.
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="food-price">₹220</span>
                            <a asp-controller="Resturent"
                               asp-action="ordernow"
                               class="btn-order">Order Now</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="menu-card">
                    <div class="food-image">🍕</div>
                    <div class="menu-content">
                        <span class="food-category">Dinner</span>
                        <h5 class="mt-2">Vegetable Pizza</h5>
                        <p class="text-secondary">
                            Pizza topped with vegetables and melted cheese.
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="food-price">₹250</span>
                            <a asp-controller="Resturent"
                               asp-action="ordernow"
                               class="btn-order">Order Now</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="menu-card">
                    <div class="food-image">🍔</div>
                    <div class="menu-content">
                        <span class="food-category">Fast Food</span>
                        <h5 class="mt-2">Veg Burger</h5>
                        <p class="text-secondary">
                            A tasty vegetable patty served in a soft bun.
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="food-price">₹150</span>
                            <a asp-controller="Resturent"
                               asp-action="ordernow"
                               class="btn-order">Order Now</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="menu-card">
                    <div class="food-image">🍜</div>
                    <div class="menu-content">
                        <span class="food-category">Main Course</span>
                        <h5 class="mt-2">Vegetable Noodles</h5>
                        <p class="text-secondary">
                            Noodles tossed with fresh vegetables and spices.
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="food-price">₹180</span>
                            <a asp-controller="Resturent"
                               asp-action="ordernow"
                               class="btn-order">Order Now</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-lg-4">
                <div class="menu-card">
                    <div class="food-image">🥤</div>
                    <div class="menu-content">
                        <span class="food-category">Beverages</span>
                        <h5 class="mt-2">Fresh Juice</h5>
                        <p class="text-secondary">
                            A refreshing juice to complement your meal.
                        </p>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="food-price">₹90</span>
                            <a asp-controller="Resturent"
                               asp-action="ordernow"
                               class="btn-order">Order Now</a>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="order-section">
            <h3 class="fw-bold">Ready to Place Your Order?</h3>
            <p class="text-secondary">
                Choose your favourite dishes and submit your order.
            </p>

            <a asp-controller="Resturent"
               asp-action="ordernow"
               class="btn btn-success px-4 py-2">
                Place an Order
            </a>
        </div>

    </div>

    <footer>
        <p class="mb-1">© 2026 Lemon Tree Hotel</p>
        <p class="mb-0">Enjoy delicious food and excellent hospitality.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
