@model PureTechnologyTask.Models.userRegister

@{
    ViewBag.Title = "User Registration";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>User Registration - Lemon Tree Hotel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            padding: 35px 0;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #123047, #2563eb);
        }

        .registration-card {
            max-width: 750px;
            margin: auto;
            padding: 35px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .hotel-title {
            color: #123047;
            font-weight: bold;
            text-align: center;
        }

        .subtitle {
            color: #6c757d;
            text-align: center;
            margin-bottom: 25px;
        }

        .form-label {
            font-weight: 600;
            color: #123047;
        }

        .form-control, .form-select {
            padding: 11px;
            border-radius: 8px;
        }

        .btn-register {
            background: #198754;
            color: white;
            padding: 12px;
            border: none;
            border-radius: 8px;
            font-weight: bold;
        }

            .btn-register:hover {
                background: #146c43;
                color: white;
            }

        @@media (max-width: 576px) {
            .registration-card {
                padding: 22px;
            }
        }
    </style>
</head>
<body>

    <div class="container px-3">
        <div class="registration-card">

            <h2 class="hotel-title">🍋 Lemon Tree Hotel</h2>
            <p class="subtitle">Create Your User Account</p>

            @if (ViewData["status"] != null)
            {
                <div class="alert alert-info">
                    @ViewData["status"]
                </div>
            }

            <form asp-controller="UserRegistration"
                  asp-action="UserReg"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="name" class="form-label">Full Name</label>
                        <input asp-for="name" class="form-control"
                               placeholder="Enter full name" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="email" class="form-label">Email Address</label>
                        <input asp-for="email" type="email" class="form-control"
                               placeholder="Enter email address" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="mobile_no" class="form-label">Mobile Number</label>
                        <input asp-for="mobile_no" type="tel" class="form-control"
                               placeholder="Enter 10-digit mobile number"
                               maxlength="10" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="gender" class="form-label">Gender</label>
                        <select asp-for="gender" class="form-select" required>
                            <option value="">Select Gender</option>
                            <option value="Male">Male</option>
                            <option value="Female">Female</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Date_of_birth" class="form-label">Date of Birth</label>
                        <input asp-for="Date_of_birth" type="date"
                               class="form-control" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="address" class="form-label">Address</label>
                        <input asp-for="address" class="form-control"
                               placeholder="Enter address" />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="password" class="form-label">Password</label>
                        <input asp-for="password" type="password"
                               class="form-control"
                               placeholder="Create password" required />
                    </div>

                    <div class="col-md-6">
                        <label asp-for="confirm_password" class="form-label">
                            Confirm Password
                        </label>
                        <input asp-for="confirm_password" type="password"
                               class="form-control"
                               placeholder="Confirm password" required />
                    </div>

                    <div class="col-12 mt-4">
                        <button type="submit"
                                class="btn btn-register w-100">
                            Register Now
                        </button>
                    </div>

                </div>
            </form>

            <div class="text-center mt-4">
                <p>
                    Already have an account?
                    <a asp-controller="UserRegistration"
                       asp-action="userlogin">Login here</a>
                </p>

                <a asp-controller="Home" asp-action="Index">
                    Back to Home
                </a>
            </div>

        </div>
    </div>

</body>
</html>
