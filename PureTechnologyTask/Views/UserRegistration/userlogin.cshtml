@{
    ViewBag.Title = "User Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>User Login - Lemon Tree Hotel</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            margin: 0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
            background: linear-gradient(135deg, #123047, #2563eb);
        }

        .login-card {
            width: 100%;
            max-width: 430px;
            padding: 35px;
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .hotel-title {
            color: #123047;
            font-weight: bold;
            text-align: center;
        }

        .login-subtitle {
            color: #6c757d;
            text-align: center;
            margin-bottom: 25px;
        }

        .form-label {
            font-weight: 600;
            color: #123047;
        }

        .form-control {
            padding: 12px;
            border-radius: 8px;
        }

        .btn-login {
            width: 100%;
            padding: 12px;
            background: #198754;
            color: white;
            border: none;
            border-radius: 8px;
            font-weight: bold;
        }

            .btn-login:hover {
                background: #146c43;
            }

        .bottom-links {
            text-align: center;
            margin-top: 20px;
        }

            .bottom-links a {
                text-decoration: none;
                color: #0d6efd;
            }
    </style>
</head>
<body>

    <div class="container px-3">
        <div class="login-card mx-auto">

            <h2 class="hotel-title">🍋 Lemon Tree Hotel</h2>
            <p class="login-subtitle">User Login</p>

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-danger" role="alert">
                    @ViewBag.Message
                </div>
            }

            <form asp-controller="UserRegistration"
                  asp-action="userlogin"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="email" class="form-label">Email Address</label>
                    <input type="email"
                           id="email"
                           name="email"
                           class="form-control"
                           placeholder="Enter your email"
                           required />
                </div>

                <div class="mb-4">
                    <label for="password" class="form-label">Password</label>
                    <input type="password"
                           id="password"
                           name="password"
                           class="form-control"
                           placeholder="Enter your password"
                           required />
                </div>

                <button type="submit" class="btn-login">
                    Login
                </button>

            </form>

            <div class="bottom-links">
                <p>
                    Don't have an account?
                    <a asp-controller="UserRegistration"
                       asp-action="UserReg">Register here</a>
                </p>

                <a asp-controller="Home" asp-action="Index">
                    Back to Home
                </a>
            </div>

        </div>
    </div>

</body>
</html>
@*
